<%@page pageEncoding="UTF-8"%>
<header class="manager-header">
    <div>
        <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Mở menu"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <h1>${pageTitle}</h1>
    </div>
    <div class="manager-header-actions">
        <button class="header-icon" type="button" title="Thông báo" aria-label="Thông báo"><svg viewBox="0 0 24 24"><path d="M10.3 21a2 2 0 0 0 3.4 0"/><path d="M4 17h16c-1.5-1.5-2-3-2-9A6 6 0 0 0 6 8c0 6-0.5 7.5-2 9Z"/></svg><span>0</span></button>
        <div class="manager-avatar">${fn:substring(manager.fullName, 0, 1)}<i></i></div>
    </div>
</header>
