<%@page pageEncoding="UTF-8"%>
<header class="manager-header">
    <div>
        <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Mở menu"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <h1>${pageTitle}</h1>
    </div>
    <div class="manager-header-actions">
        <a class="manager-avatar" href="${pageContext.request.contextPath}/manager/account" title="Tài khoản của tôi" aria-label="Tài khoản của tôi">${fn:substring(manager.fullName, 0, 1)}<i></i></a>
    </div>
</header>
