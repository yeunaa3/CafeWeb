<%@page pageEncoding="UTF-8"%>
<header class="manager-header">
    <div>
        <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Mở menu"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <h1>${pageTitle}</h1>
    </div>
    <div class="manager-header-actions">
        <a class="header-icon" href="${pageContext.request.contextPath}/manager/orders?status=Pending" title="Đơn chờ duyệt" aria-label="Đơn chờ duyệt"><svg viewBox="0 0 24 24"><path d="M10.3 21a2 2 0 0 0 3.4 0"/><path d="M4 17h16c-1.5-1.5-2-3-2-9A6 6 0 0 0 6 8c0 6-.5 7.5-2 9Z"/></svg><c:if test="${pendingOrderCount > 0}"><span>${pendingOrderCount}</span></c:if></a>
        <a class="manager-avatar" href="${pageContext.request.contextPath}/manager/account" title="Tài khoản của tôi" aria-label="Tài khoản của tôi"><c:choose><c:when test="${not empty manager.displayAvatarUrl}"><img src="${pageContext.request.contextPath}${manager.displayAvatarUrl}" alt=""></c:when><c:otherwise>${fn:substring(manager.fullName, 0, 1)}</c:otherwise></c:choose><i></i></a>
    </div>
</header>
